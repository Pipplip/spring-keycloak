{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "node scripts/generate-api-client.mjs",
    "build": "ng build",
    "prebuild": "node scripts/generate-api-client.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pretest": "node scripts/generate-api-client.mjs",
    "test:watch": "ng test --watch",
    "pretest:watch": "node scripts/generate-api-client.mjs",
    "test:e2e": "playwright test",
    "lint": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"scripts/**/*.mjs\""
  },
  "engines": {
    "node": "22.23.x",
    "npm": ">=10 <12"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/animations": "21.2.26",
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "keycloak-js": "26.2.5",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "jsdom": "28.0.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}