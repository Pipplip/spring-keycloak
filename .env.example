POSTGRES_DB=abfallcontainer
POSTGRES_USER=abfallcontainer
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-local-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-password
KEYCLOAK_PORT=8081
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/abfallcontainer-realm
KEYCLOAK_API_AUDIENCE=abfallcontainer-backend
ABFALLCONTAINER_ADMIN_USERNAME=local-admin
ABFALLCONTAINER_ADMIN_PASSWORD=replace-with-a-local-password

# Local image-based Compose configuration (public URLs, no secrets)
API_BASE_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8081
FRONTEND_ALLOWED_ORIGIN=http://localhost:4200
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Deployment secrets are read from these local files; never commit them.
DEPLOYMENT_POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
DEPLOYMENT_KEYCLOAK_DB_PASSWORD_FILE=./secrets/keycloak_db_password.txt
DEPLOYMENT_KEYCLOAK_ADMIN_PASSWORD_FILE=./secrets/keycloak_admin_password.txt
